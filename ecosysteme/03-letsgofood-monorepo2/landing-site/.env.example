# ═══ LET'S GO FOOD — LANDING SITE CONFIG ═══

# MODE : "lead" (acquisition uniquement, aucun accès app)
#      | "app"  (connexion + inscription activées)
VITE_MODE=lead

# URL de l'application (pour les redirections en mode "app")
VITE_APP_URL=https://app.letsgofood.fr

# Backend recevant les leads (même domaine par défaut)
# Laisser vide pour désactiver l'envoi réel (le form affiche juste le succès)
VITE_API_BASE_URL=https://app.letsgofood.fr
VITE_LEAD_ENDPOINT=/api/leads

# Overrides optionnels (par défaut : suit le MODE)
# VITE_ENABLE_CONNEXION=false
# VITE_ENABLE_SIGNUP=false
# VITE_ENABLE_URGENCY=true
