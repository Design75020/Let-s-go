rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DENY ALL BY DEFAULT
    match /{document=**} {
      allow read, write: if false;
    }

    // HELPERS
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isTenant(tenantId) { return isSignedIn() && request.auth.token.tenantId == tenantId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // USERS
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && 
        incoming().keys().hasAll(['name', 'email', 'role']) &&
        incoming().role in ['client', 'merchant', 'driver'];
      allow update: if isSignedIn() && isOwner(userId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name']);
    }

    // RESTAURANTS
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        incoming().ownerId == request.auth.uid &&
        incoming().tenantId == request.auth.token.tenantId;
      allow update: if isSignedIn() && 
        existing().ownerId == request.auth.uid &&
        incoming().tenantId == existing().tenantId;
    }

    // MENU ITEMS
    match /restaurants/{restaurantId}/menuItems/{itemId} {
      allow read: if true;
      allow write: if isSignedIn() && 
        get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    // AUDIT LOGS (Immutable)
    match /audit_logs/{logId} {
      allow read: if isSignedIn() && request.auth.token.role == 'admin';
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ORDERS
    match /orders/{orderId} {
      allow get: if isSignedIn() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.driverId == request.auth.uid ||
        get(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)).data.ownerId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.tenantId == request.auth.token.tenantId &&
        (resource.data.clientId == request.auth.uid || resource.data.driverId == request.auth.uid)
      );
      allow create: if isSignedIn() && incoming().tenantId == request.auth.token.tenantId;
      allow update: if isSignedIn() && existing().tenantId == request.auth.token.tenantId;
    }
  }
}
