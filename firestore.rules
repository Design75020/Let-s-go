rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Auth Token Integrity
    function isVerified() { 
      return isSignedIn() && request.auth.token.email_verified == true; 
    }

    // Role-based Access Control
    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && getUserData(request.auth.uid).role == 'admin';
    }

    // Relational Helpers
    function getRestaurant(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)).data;
    }

    // 1. Validation Blueprints (The "Anti-Update-Gap")

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
             data.role in ['client', 'merchant', 'driver', 'admin'] &&
             data.createdAt is string; // Using string as per the code implementation
    }

    function isValidRestaurant(data) {
      return data.keys().hasAll(['name', 'ownerId', 'status', 'category', 'rating']) &&
             data.keys().size() == 5 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.ownerId == request.auth.uid &&
             data.status in ['open', 'closed'] &&
             data.category is string &&
             data.rating is number;
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['restaurantId', 'name', 'price', 'category', 'available']) &&
             data.keys().size() == 5 &&
             data.restaurantId is string &&
             data.name is string && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.available is bool;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['clientId', 'clientName', 'restaurantId', 'restaurantName', 'merchantId', 'status', 'items', 'total', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 10 &&
             data.clientId == request.auth.uid &&
             data.status in ['pending', 'accepted', 'preparing', 'picked_up', 'delivered', 'cancelled'] &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    // 2. Resource Match Blocks

    // --- USERS ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin(); 
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'role', 'photoURL']);
    }

    // --- RESTAURANTS ---
    match /restaurants/{restaurantId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidRestaurant(incoming());
      allow update: if (isOwner(existing().ownerId) || isAdmin()) && isValidRestaurant(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'status', 'category', 'rating', 'aiMenuAdvice', 'aiAdviceAt']);
      
      // --- MENU ITEMS (Sub-collection) ---
      match /menuItems/{itemId} {
        allow read: if isSignedIn();
        allow write: if (isOwner(getRestaurant(restaurantId).ownerId) || isAdmin()) && isValidMenuItem(incoming());
      }
    }

    // --- ORDERS ---
    match /orders/{orderId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        isOwner(existing().clientId) || 
        isOwner(getRestaurant(existing().restaurantId).ownerId) ||
        (existing().driverId != null && isOwner(existing().driverId))
      );
      
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.clientId == request.auth.uid ||
        resource.data.merchantId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );

      allow create: if isVerified() && isValidOrder(incoming()) &&
                    exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId));

      allow update: if (isSignedIn() && (
        isAdmin() ||
        // Client can cancel
        (isOwner(existing().clientId) && incoming().status == 'cancelled' && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        
        // Merchant can update status
        (isOwner(resource.data.merchantId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        
        // Driver can pick up/deliver
        (isVerified() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'driverId', 'updatedAt']))
      ));
    }
  }
}
